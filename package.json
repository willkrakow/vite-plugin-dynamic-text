{
  "name": "vite-plugin-dynamic-text",
  "version": "0.1.0",
  "description": "Edit your site's copy in place during `vite dev`: Alt+click any text, change it, and it's written back to a JSON file.",
  "keywords": [
    "vite",
    "vite-plugin",
    "react",
    "copy",
    "cms",
    "content-editing",
    "i18n"
  ],
  "license": "MIT",
  "author": "Will Krakow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willkrakow/vite-plugin-dynamic-text.git"
  },
  "homepage": "https://github.com/willkrakow/vite-plugin-dynamic-text#readme",
  "bugs": "https://github.com/willkrakow/vite-plugin-dynamic-text/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "client.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
